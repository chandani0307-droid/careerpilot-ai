# ───────── CareerPilot AI configuration ─────────
# Copy to `.env` (project root or /backend). Every key is OPTIONAL: with none set,
# the app runs fully in offline mode using templates + sample jobs.

# ── LLM ──  auto | gemini | ollama | mock   (auto = gemini if a key is set, else mock)
LLM_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local & free alternative: install Ollama, `ollama pull llama3.1`, `pip install langchain-ollama`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Job sources (free; first four need no key) ──
JOB_PROVIDERS=remotive,remoteok,arbeitnow,rss,adzuna
# Comma-separated RSS/Atom job feeds
JOB_RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss
# Adzuna free tier (best free source for India): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in,gb,us
# Fill in sample listings when live sources return few results
MOCK_JOBS_FALLBACK=true
HTTP_TIMEOUT=8

# ── Optional contact lookup (Hunter.io free tier) ──
HUNTER_API_KEY=

# ── Optional email sending. Leave empty to get a mailto: draft instead ──
# Gmail: enable 2-step verification, then create an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Database ──  default is SQLite (backend/careerpilot.db)
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/careerpilot
DATABASE_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
